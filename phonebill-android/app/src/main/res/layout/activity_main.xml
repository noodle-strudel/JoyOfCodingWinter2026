<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/phoneBillAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/phone_bill_title"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@id/phoneBills"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ListView
        android:id="@+id/phoneBills"
        android:layout_width="409dp"
        android:layout_height="152dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="203dp"
        app:layout_constraintTop_toBottomOf="@id/phoneBillAppTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/launchPhoneBillRecorder" />

    <Button
        android:id="@+id/launchPhoneBillRecorder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:onClick="launchCalculator"
        android:text="@string/record_a_phone_bill_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phoneBills" />







</androidx.constraintlayout.widget.ConstraintLayout>