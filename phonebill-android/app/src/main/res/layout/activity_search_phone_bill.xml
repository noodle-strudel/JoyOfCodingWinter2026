<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SearchPhoneBillActivity">

    <LinearLayout
        android:id="@+id/searchPhoneBillOptionsBlock"
        android:layout_width="388dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="36dp"
        android:layout_weight="2"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/searchPhoneBillListView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/searchPhoneCallTitle">

        <LinearLayout
            android:id="@+id/searchPhoneBillOptionsTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="horizontal"
                android:weightSum="2">

                <TextView
                    android:id="@+id/searchPhoneBillCustomerNameLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/customer_name"
                    android:textAlignment="viewStart" />

                <EditText
                    android:id="@+id/searchPhoneBillCustomerNameField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="text" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/searchPhoneCallBetweenRangeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:checked="false"
                android:text="Search between time range" />

            <LinearLayout
                android:id="@+id/searchPhoneBillTimeRangeBlock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="8">

                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="@string/call_begin_time" />

                    <EditText
                        android:id="@+id/searchPhoneCallBeginTimeField"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="4"
                        android:ems="10"
                        android:inputType="datetime" />

                    <Spinner
                        android:id="@+id/searchBeginTimeSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="8">

                    <TextView
                        android:id="@+id/textView3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="@string/call_end_time" />

                    <EditText
                        android:id="@+id/searchPhoneCallEndTimeField"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="4"
                        android:ems="10"
                        android:inputType="text" />

                    <Spinner
                        android:id="@+id/searchEndTimeSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/searchPhoneBillButtons"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/clear_form" />

            <Button
                android:id="@+id/submitSearchButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="searchForPhoneBillAndCalls"
                android:text="@string/submit" />
        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/searchPhoneBillListView"
        android:layout_width="302dp"
        android:layout_height="350dp"
        android:layout_marginStart="54dp"
        android:layout_marginTop="23dp"
        android:layout_marginEnd="55dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/searchPhoneBillOptionsBlock" />

    <Button
        android:id="@+id/searchActivityBackToMainButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:onClick="goBackToMainActivity"
        android:text="@string/back_to_main"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchPhoneBillListView" />

    <TextView
        android:id="@+id/searchPhoneCallTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Search for Phone Bills/Phone Calls"
        app:layout_constraintBottom_toTopOf="@+id/searchPhoneBillOptionsBlock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>