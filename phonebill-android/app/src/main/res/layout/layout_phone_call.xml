<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/phoneCallCallerBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:textAlignment="inherit"
        app:flow_horizontalAlign="center"
        app:flow_verticalAlign="center"
        app:layout_constraintBottom_toTopOf="@+id/phoneCallBeginTimeBlock"
        app:layout_constraintEnd_toStartOf="@+id/phoneCallCalleeBlock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/phoneCallCallerLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Incoming Caller"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/phoneCallCallerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/phoneCallCalleeBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintBottom_toTopOf="@id/phoneCallEndTimeBlock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/phoneCallCallerBlock"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/phoneCallCalleeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Outgoing Callee"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/phoneCallCalleeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TextView"
            android:textAlignment="center" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/phoneCallBeginTimeBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/phoneCallEndTimeBlock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/phoneCallCallerBlock">

        <TextView
            android:id="@+id/phoneCallBeginTimeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/call_begin_time"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/phoneCallBeginTimeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TextView"
            android:textAlignment="center" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/phoneCallEndTimeBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/phoneCallBeginTimeBlock"
        app:layout_constraintTop_toBottomOf="@id/phoneCallCalleeBlock">

        <TextView
            android:id="@+id/phoneCallEndTimeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/call_end_time"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/phoneCallEndTimeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TextView"
            android:textAlignment="center" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>